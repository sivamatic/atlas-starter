# Copy to .env and fill in. Never commit .env or real keys.
# replay needs nothing else. live/record need LLM_BASE_URL (any OpenAI-compatible endpoint).
LLM_MODE=replay
LLM_MODEL=llama3.2:3b
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=
# Prices in USD per million tokens. Copy them from your provider's pricing page and note the date.
LLM_PRICE_IN_PER_M=0
LLM_PRICE_OUT_PER_M=0
ATLAS_MAX_STEPS=4
ATLAS_MAX_TOKENS_PER_CALL=400
ATLAS_MAX_COST_USD=0.50
ATLAS_KILL_SWITCH=0
# Week 3+: retrieval and tickets. Empty ATLAS_DB_URL = in-memory store (data is lost on restart).
# Postgres + pgvector: docker compose up -d, then
# ATLAS_DB_URL=postgresql://atlas:atlas@127.0.0.1:5433/atlas
ATLAS_DB_URL=
# hash = offline keyword-like vectors for tests and replay. live = real embeddings from LLM_BASE_URL.
EMBED_MODE=hash
EMBED_MODEL=bge-m3
ATLAS_TOP_K=4
ATLAS_TICKET_TTL_S=900
# Week 4: datasets and rerank. ATLAS_DATA_DIR=examples/bank loads another dataset (kb/, users.json, golden.json).
ATLAS_DATA_DIR=data
# off | overlap | cross-encoder (cross-encoder needs: pip install sentence-transformers)
ATLAS_RERANK=overlap
ATLAS_RERANK_POOL=20
# Week 6: tracing. auto = OpenTelemetry when an OTLP endpoint is set and requirements-otel.txt is installed,
# otherwise the built-in tracer. ATLAS_TRACE_FILE appends spans as JSON Lines.
ATLAS_TRACER=auto
ATLAS_TRACE_FILE=var/traces.jsonl
# 1 = keep question and answer text on spans (masked). Leave 0 unless you have a reason and a retention policy.
ATLAS_TRACE_CONTENT=0
# Phoenix (docker compose --profile phoenix up -d):
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:6006
# Langfuse Cloud EU (see README for US and self-hosted):
# OTEL_EXPORTER_OTLP_ENDPOINT=https://cloud.langfuse.com/api/public/otel
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20<base64 of public_key:secret_key>,x-langfuse-ingestion-version=4
OTEL_SERVICE_NAME=atlas
